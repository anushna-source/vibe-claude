# Copy to .env and adjust. Never commit a real .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000
APP_VERSION=0.1.0

# Local Postgres from docker-compose.yml (`pnpm db:up`).
# Not read by the API yet; the database layer arrives in build step 2.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
TEST_DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_test
