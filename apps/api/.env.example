# Copy to .env and adjust. Never commit a real .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000
APP_VERSION=1.0.0

# Local Postgres from docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000

# Only used by the integration tests, which create and drop a schema per run.
TEST_DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_test

# Signs access tokens. Development falls back to a built-in value; production
# refuses to start without a real one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Sign-up and login are public, so they are rate limited per IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Read once by `pnpm db:seed` to create the first Admin. Anyone else who signs
# up is a Viewer. Leave blank to skip, and change the password after first login.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Local Postgres from docker-compose.yml (`pnpm db:up`).
# Not read by the API yet; the database layer arrives in build step 2.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
TEST_DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory_test
