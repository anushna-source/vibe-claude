# Copy to .env.local and adjust. Never commit a real .env.local.

# Used by Server Components. May point at an internal address in production.
API_BASE_URL=http://localhost:4000/api/v1

# Used by the browser. Must be reachable from the user's machine and allowed by
# the API's CORS_ORIGINS.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# How long to wait for the API before giving up, in milliseconds.
API_REQUEST_TIMEOUT_MS=8000
